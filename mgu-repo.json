{
  "schema": 1,
  "apps": {
    "path": "apps/*",
    "manifest": "app.json",
    "icon": "icon.png",
    "mguHmi": [
      "ID7"
    ],
    "requires": {
      "idrive7-renderd": "2.1.7",
      "mgu-inputgate": "1.0.0"
    },
    "build": {
      "python": "kit/tools/build.py",
      "args": [
        "{id}"
      ],
      "sdk": "oap-sdk",
      "output": "dist/{id}@{version}.tgz",
      "shared": [
        "kit/runtime",
        "kit/platform",
        "kit/localization",
        "kit/tools/build.py",
        "kit/tools/pack_data.py",
        "kit/tools/localize.py",
        "kit/tools/locale-revisions.json",
        "kit/tools/oapgen",
        "oap-sdk"
      ]
    },
    "uninstallable": true
  },
  "components": [
    {
      "id": "f44-hud-bridge",
      "kind": "tool",
      "path": "f44-hud",
      "uninstallable": true,
      "requires": {
        "mgu-deploy": "0.7.17",
        "cluster-render": "0.8.13",
        "waze-on-cluster": "0.14.16"
      }
    }
  ]
}
